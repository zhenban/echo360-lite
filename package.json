{
  "name": "lite-player-for-echo360",
  "private": true,
  "description": "A lightweight replacement for the Echo360 lecture player (userscript).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src test build.mjs eslint.config.mjs",
    "check-dist": "node build.mjs && git diff --exit-code -- dist/",
    "ci": "npm run lint && npm run typecheck && npm test && npm run check-dist",
    "typecheck": "tsc -p .",
    "check-requires": "node test/check-requires.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3"
  }
}
